# ===========================================
# AWIES Docker Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Usage: docker-compose --env-file .env up -d

# Port Configuration
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ===========================================
# LLM Provider Configuration
# ===========================================
# Choose your LLM provider: "openai" or "gemini"

# Option 1: OpenAI (or OpenAI-compatible API)
# -------------------------------------------
LLM_PROVIDER=openai
LLM_API_KEY=your-openai-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Supported OpenAI models:
# - gpt-4o (recommended)
# - gpt-4-turbo
# - gpt-4
# - gpt-3.5-turbo

# Option 2: OpenAI-compatible API (e.g., OhMyGPT)
# -----------------------------------------------
# LLM_PROVIDER=openai
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.ohmygpt.com/v1
# LLM_MODEL=gpt-4o

# Option 3: Google Gemini
# -----------------------
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key-here
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-2.0-flash-001

# Supported Gemini models:
# - gemini-2.0-flash-001 (recommended, fast)
# - gemini-1.5-pro
# - gemini-1.5-flash

# ===========================================
# Logging Configuration
# ===========================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===========================================
# Important Notes
# ===========================================
# 1. For OpenAI: Get API key from https://platform.openai.com/api-keys
# 2. For Gemini: Get API key from https://makersuite.google.com/app/apikey
# 3. DO NOT commit .env file with real API keys to version control
# 4. The .env file is already in .gitignore
