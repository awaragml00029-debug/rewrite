# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# LLM API Configuration
# Choose your LLM provider: "openai" or "gemini"
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4

# Alternative: Gemini Configuration
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-api-key
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_MODEL=gemini-pro

# JANE API Configuration
JANE_WSDL_URL=http://jane.biosemantics.org:8080/JaneServer/services/JaneSOAPServer?wsdl
JANE_BASE_URL=http://jane.biosemantics.org/

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Cache Settings
CACHE_TTL=3600
ENABLE_CACHE=true

# Logging
LOG_LEVEL=INFO
