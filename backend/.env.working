# API Configuration
API_HOST=0.0.0.0
API_PORT=53431
API_RELOAD=true

# =============================================================================
# LLM API Configuration - CHOOSE ONE OF THE OPTIONS BELOW
# =============================================================================

# OPTION 1: For Gemini API proxy at off.092420.xyz (YOUR CASE)
# If your API endpoint is like: https://off.092420.xyz/v1/...
# And you're using gemini models, use THIS configuration:

LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://off.092420.xyz/v1beta
LLM_MODEL=gemini-2.5-flash

# NOTE: Remove the "/chat/completions" part from the URL!
# Gemini API format is different from OpenAI format

# -----------------------------------------------------------------------------

# OPTION 2: For standard OpenAI API
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-your-openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4

# -----------------------------------------------------------------------------

# OPTION 3: For OpenAI-compatible proxy (like LM Studio, Ollama, etc.)
# LLM_PROVIDER=openai
# LLM_API_KEY=not-needed
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=your-model-name

# =============================================================================

# JANE API Configuration
JANE_WSDL_URL=http://jane.biosemantics.org:8080/JaneServer/services/JaneSOAPServer?wsdl
JANE_BASE_URL=http://jane.biosemantics.org/

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false

# CORS Settings
CORS_ORIGINS=["http://localhost:3003","http://localhost:5173"]

# Cache Settings
CACHE_TTL=3600
ENABLE_CACHE=true

# Logging
LOG_LEVEL=INFO
