# Recommended Configuration for OhMyGPT API
# ===========================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=53431
API_RELOAD=true

# LLM API Configuration - OhMyGPT
LLM_PROVIDER=openai
LLM_API_KEY=<YOUR_OHMYGPT_API_KEY>
LLM_BASE_URL=https://api.ohmygpt.com/v1
LLM_MODEL=gpt-4o

# Alternative models (according to OhMyGPT docs):
# LLM_MODEL=gpt-4o              # Recommended for best quality
# LLM_MODEL=gemini-2.0-flash-001  # Fast and capable
# LLM_MODEL=claude-3-5-sonnet-20241022  # If available

# IMPORTANT: DO NOT USE gpt-5-nano - it has severe limitations:
# - Only supports temperature=1 (default)
# - Returns empty responses (0 characters)
# - Not suitable for text enhancement tasks

# JANE API Configuration
JANE_WSDL_URL=http://jane.biosemantics.org:8080/JaneServer/services/JaneSOAPServer?wsdl
JANE_BASE_URL=http://jane.biosemantics.org/

# Redis Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_ENABLED=false

# CORS Settings
CORS_ORIGINS=["http://localhost:3003","http://localhost:5173"]

# Cache Settings
CACHE_TTL=3600
ENABLE_CACHE=true

# Logging
LOG_LEVEL=INFO
